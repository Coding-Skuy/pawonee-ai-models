{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Skema Resep dan Preferensi Pawonee",
  "type": "object",
  "definitions": {
    "bahan": {
      "type": "object",
      "required": ["nama"],
      "properties": {
        "nama": { "type": "string", "minLength": 1 },
        "jumlah": { "type": "string" }
      },
      "additionalProperties": false
    },
    "resep": {
      "type": "object",
      "required": ["id", "nama", "bahan", "langkah", "menit", "levelPedas", "estimasiBiaya"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "nama": { "type": "string", "minLength": 1 },
        "bahan": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/bahan" } },
        "langkah": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "menit": { "type": "integer", "minimum": 1, "maximum": 240 },
        "levelPedas": { "type": "integer", "minimum": 0, "maximum": 5 },
        "estimasiBiaya": { "type": "integer", "minimum": 0 },
        "grade": { "type": "integer", "const": 2 }
      },
      "additionalProperties": false
    }
  },
  "properties": {
    "resep": { "type": "array", "items": { "$ref": "#/definitions/resep" } }
  }
}
